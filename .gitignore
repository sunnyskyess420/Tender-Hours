db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# ─── Env / secrets ────────────────────────────────────
.env
.env*.local
.env.production
.env.production.local
.env.development
.env.development.local
.env.test
.env.test.local

# ─── Logs ─────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*
.pnpm-debug.log*
logs/
*.log

# ─── Editor / OS ──────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ─── TypeScript / ESLint caches ───────────────────────
*.tsbuildinfo
.eslintcache
next-env.d.ts

# ─── Vercel ───────────────────────────────────────────
.vercel

# ─── Runtime / tmp files ─────────────────────────────
.cache/
.tmp/
tmp/

# ─── Zscripts (local dev scaffolding) ─────────────────
.zscripts/
dev.log
server.log

# ─── Local skills cache (not part of the app) ──────────
skills/

# ─── Local downloads / scratch dir ────────────────────
download/


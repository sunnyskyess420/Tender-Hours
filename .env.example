# Tender Hours environment variables
#
# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# Prisma database connection string.
#
# Local dev (default): use a local SQLite file
#   file:/home/z/my-project/db/custom.db
#
# Railway: mount a persistent volume at /data and use
#   file:/data/tender-hours.db
#
# Vercel + Vercel Postgres: change schema.prisma provider to "postgresql"
# and use the connection string Vercel gives you, e.g.
#   postgres://user:password@host:port/dbname
#
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# ── AI features (journal scan + weekly reflection) ─────────────────────────
# Any OpenAI-compatible provider works. Set at least OPENAI_API_KEY to enable;
# add the other two for Groq / Gemini / OpenRouter / Together, etc.
# OPENAI_API_KEY="..."
# OPENAI_BASE_URL="https://api.groq.com/openai/v1"
# OPENAI_MODEL="llama-3.3-70b-versatile"
